{
  "name": "flowdiff",
  "version": "0.0.0",
  "description": "Version control and human-readable diffs for n8n workflows, via the n8n public API.",
  "type": "module",
  "license": "MIT",
  "author": "Francis Akoji",
  "keywords": [
    "n8n",
    "workflow",
    "diff",
    "git",
    "version-control",
    "cli"
  ],
  "bin": {
    "flowdiff": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "tsup": "^9.0.0",
    "typescript": "~6.0",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "commander": "^15.1.0",
    "picocolors": "^1.1.1",
    "zod": "^4.6.7"
  }
}
