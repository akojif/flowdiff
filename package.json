{
  "name": "@akojif/flowdiff",
  "version": "0.1.1",
  "description": "Version control and readable diffs for n8n workflows, via the n8n public API.",
  "keywords": [
    "n8n",
    "workflow",
    "git",
    "diff",
    "version-control",
    "cli"
  ],
  "homepage": "https://github.com/akojif/flowdiff#readme",
  "bugs": {
    "url": "https://github.com/akojif/flowdiff/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/akojif/flowdiff.git"
  },
  "license": "MIT",
  "author": "Francis Akoji",
  "type": "module",
  "bin": {
    "flowdiff": "dist/cli.js"
  },
  "files": [
    "dist/cli.js",
    "README.md",
    "LICENSE",
    "action.yml"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "changeset": "changeset",
    "prepublishOnly": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "commander": "^15.1.0",
    "diff": "^9.0.0",
    "picocolors": "^1.1.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "tsup": "^9.0.0",
    "typescript": "~6.0",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
